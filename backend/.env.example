# ==============================================================================
# CHIRON AEROSPACE HEALTH OS - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# NASA Space Apps Challenge 2026
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OpenAI Clinical AI & Voice Orchestration (gpt-4o-mini / Whisper / TTS)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=onyx
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_STRUCTURED_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. Vapi Voice AI WebRTC Live Assistant Configuration
# ------------------------------------------------------------------------------
VAPI_PUBLIC_KEY=6d3c0558-a0ff-4c99-a3ba-436e0698b9a8
VAPI_PRIVATE_KEY=your_vapi_private_key_here
VAPI_ASSISTANT_ID=c10cc8c9-e082-451c-aaad-6c1100515d7c

# ------------------------------------------------------------------------------
# 3. Spaceflight Operational Air-Gap Mode
# Set to 'true' for 100% deterministic local physics computation (zero network calls)
# Set to 'false' for live hybrid aerospace AI inferencing
# ------------------------------------------------------------------------------
AIRGAP_FORCE_OFFLINE=false

# ------------------------------------------------------------------------------
# 4. Networking & Telemetry Host Settings
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

